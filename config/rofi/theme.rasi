* {
    bg-col:      #1e1e2eE6;
    bg-col-alt:  #292c3caa;
    fg-col:      #cdd6f4;
    accent:      #89b4fa;
    border-col:  #4c7899;
    urgent-col:  #f38ba8;

    background-color: transparent;
    text-color: @fg-col;
    font: "MesloLGS Nerd Font Mono 11";
}

window {
    background-color: @bg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 14px;
    padding: 12px;
    width: 600px;
    location: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-col-alt;
    text-color: @fg-col;
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    background-color: transparent;
    text-color: @fg-col;
    placeholder: "Search...";
    placeholder-color: @fg-col;
}

listview {
    background-color: transparent;
    lines: 8;
    columns: 1;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg-col;
    padding: 8px 10px;
    border-radius: 10px;
}

element selected {
    background-color: @accent;
    text-color: @bg-col;
}

element-icon {
    size: 20px;
    padding: 0 8px 0 0;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
